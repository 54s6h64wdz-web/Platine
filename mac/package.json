{
  "name": "platine",
  "productName": "Platine",
  "version": "1.0.0",
  "description": "Platine — lecteur audio pour beatmakers (version Mac)",
  "author": "genetic",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac zip dmg"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.genetic.platine",
    "productName": "Platine",
    "files": ["main.js", "preload.js", "web/**/*", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [{ "target": "dmg", "arch": ["universal"] }, { "target": "zip", "arch": ["universal"] }],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Platine n'utilise pas le micro.",
        "CFBundleDisplayName": "Platine"
      }
    },
    "dmg": { "title": "Platine", "backgroundColor": "#0f0f10" }
  }
}
